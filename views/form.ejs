<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/styles.css">
        <link rel="icon" type="image/svg+xml" href="/Logo.svg">
        <title>Message Board</title>
    </head>
    <body>
        <%- include('header') %>
        <main id="formMain">
            <%- include ("partials/errors.ejs") %>
            <form method="POST" action="/new">
                <label for="nameInput">Put your name:</label>
                <input name="nameInput" type="text" id="nameInput" required placeholder="David">
                <label for="messageInput">Put your message:</label>
                <textarea name="messageInput" id="messageInput" required maxlength="200" placeholder="Very good"></textarea>
                <button type="submit">Submit</button>
            </form>
        </main>
        <%- include('footer') %>
    </body>
</html>