<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/svg+xml" href="/Logo.svg">
    <title>Message Board</title>
</head>
<body>
    <header>
        <h1> <%= title %> </h1>
    </header>
    <main>

        <div id="board">
            <% messages.map((message) => { %>
            <div class="message">
                <h3> <%= message.user %> </h3>
                <p class="theMessage"> <%= message.text %> </p>
                <p class="date"> <%= new Intl.DateTimeFormat("es-MX", options).format(message.added) %> </p>
            </div>
            <% }) %>
        </div>

    </main>
    <footer>
        <p>This page was made by Ivanovichis production</p>
    </footer>
</body>
</html>